# Copy this file to .env and adjust values before running in production.

# SQLite (default, zero-config, good for small/medium libraries):
DATABASE_URL=sqlite:///./library.db

# Or PostgreSQL (recommended for larger/multi-user deployments):
# DATABASE_URL=postgresql://library_user:library_pass@localhost:5432/library_db

# IMPORTANT: generate a real random secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_super_secret_key

ACCESS_TOKEN_EXPIRE_MINUTES=720

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

BACKUP_DIR=./backups
UPLOAD_DIR=./uploads
